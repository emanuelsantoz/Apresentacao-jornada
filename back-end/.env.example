# Token do Vercel Blob (criado ao conectar o Blob ao projeto na Vercel).
BLOB_READ_WRITE_TOKEN=

# Chave exigida nas rotas que alteram dados (PUT/PATCH/DELETE).
# Gere uma longa: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_TOKEN=

# Origens que podem chamar a API pelo navegador, separadas por vírgula. Vazio = qualquer origem.
ALLOWED_ORIGINS=http://localhost:5173
